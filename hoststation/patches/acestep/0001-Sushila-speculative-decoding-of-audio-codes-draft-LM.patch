+
+// Sushila: speculative verification forward. N consecutive KV sets [s0..s0+N),
+// T tokens each (token_ids[n*T + t]), all positions' logits out:
+// logits[(n*T + t) * out_V]. Each set's T tokens are written at kv_pos[set]..+T-1
+// and kv_pos advances by T; the caller rolls kv_pos back past rejected tokens
+// (stale rows beyond kv_pos are masked, then overwritten).
+static void qw3lm_forward_verify(Qwen3LM *   m,
+                                 const int * token_ids,
+                                 int         s0,
+                                 int         N,
+                                 int         T,
+                                 float *     logits,
+                                 int         lm_offset = 0,
+                                 int         lm_count  = 0) {
+    const Qwen3LMConfig & c   = m->cfg;
+    int                   D   = c.head_dim;
+    int                   Nh  = c.n_heads;
+    int                   Nkv = c.n_kv_heads;
+    const int             NT  = N * T;
+
+    int max_kv_len = 0;
+    for (int i = 0; i < N; i++) {
+        int kl = m->kv_pos[s0 + i] + T;
+        if (kl > c.max_seq_len) {
+            fprintf(stderr, "[LM-Verify] FATAL: kv_len %d > max_seq %d (set %d)\n", kl, c.max_seq_len, s0 + i);
+            exit(1);
+        }
+        max_kv_len = kl > max_kv_len ? kl : max_kv_len;
+    }
+    const int kv_pad_raw = (int) GGML_PAD(max_kv_len, 256);
+    const int n_kv_pad   = kv_pad_raw < c.max_seq_len ? kv_pad_raw : c.max_seq_len;
+
+    if (m->batch_graph.graph.sched_allocated) {
+        static_graph_release(&m->batch_graph.graph, m->sched);
+        m->batch_graph.built = false;
+    }
+
+    Qw3lmGraphCache & G          = m->verify_graph;
+    const bool        need_build = !G.built || G.key_n_kv_pad != n_kv_pad || G.key_N != N || G.key_s0 != s0 ||
+                            m->verify_key_T != T || G.key_lm_offset != lm_offset || G.key_lm_count != lm_count;
+    if (need_build) {
+        static_graph_release(&G.graph, m->sched);
+        G.built                  = false;
+        struct ggml_context * ctx = graph_arena_begin(&m->arena_verify);
+        struct ggml_cgraph *  gf  = ggml_new_graph_custom(ctx, QW3LM_GRAPH_NODES, false);
+
+        struct ggml_tensor * token_ids_t = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, NT);
+        ggml_set_name(token_ids_t, "token_ids");
+        ggml_set_input(token_ids_t);
+        struct ggml_tensor * positions = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, NT);
+        ggml_set_name(positions, "positions");
+        ggml_set_input(positions);
+        // mask [n_kv_pad, T, 1, N]: query t of set n sees columns <= kv_pos[n] + t
+        struct ggml_tensor * attn_mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, n_kv_pad, T, 1, N);
+        ggml_set_name(attn_mask, "attn_mask");
+        ggml_set_input(attn_mask);
+        // write rows [T, 1, N], broadcast across Nkv
+        struct ggml_tensor * kv_rows = ggml_new_tensor_3d(ctx, GGML_TYPE_I64, T, 1, N);
+        ggml_set_name(kv_rows, "kv_rows");
+        ggml_set_input(kv_rows);
+
+        struct ggml_tensor * hidden = ggml_get_rows(ctx, m->embed_tokens, token_ids_t);  // [H, NT]
+        for (int l = 0; l < c.n_layers; l++) {
+            Qwen3Layer *         ly   = &m->layers[l];
+            struct ggml_tensor * norm = qwen3_rms_norm(ctx, hidden, ly->input_layernorm, c.rms_norm_eps);
+            struct ggml_tensor *q, *k, *v;
+            int                 q_dim  = Nh * D;
+            int                 kv_dim = Nkv * D;
+            if (ly->qkv) {
+                struct ggml_tensor * qkv = qwen3_linear(ctx, ly->qkv, norm);
+                q                        = ggml_cont(ctx, ggml_view_2d(ctx, qkv, q_dim, NT, qkv->nb[1], 0));
+                k = ggml_cont(ctx, ggml_view_2d(ctx, qkv, kv_dim, NT, qkv->nb[1], (size_t) q_dim * qkv->nb[0]));
+                v = ggml_cont(ctx,
+                              ggml_view_2d(ctx, qkv, kv_dim, NT, qkv->nb[1], (size_t) (q_dim + kv_dim) * qkv->nb[0]));
+            } else if (ly->qk) {
+                struct ggml_tensor * qk = qwen3_linear(ctx, ly->qk, norm);
+                q                       = ggml_cont(ctx, ggml_view_2d(ctx, qk, q_dim, NT, qk->nb[1], 0));
+                k = ggml_cont(ctx, ggml_view_2d(ctx, qk, kv_dim, NT, qk->nb[1], (size_t) q_dim * qk->nb[0]));
+                v = qwen3_linear(ctx, ly->v_proj, norm);
+            } else {
+                q = qwen3_linear(ctx, ly->q_proj, norm);
+                k = qwen3_linear(ctx, ly->k_proj, norm);
+                v = qwen3_linear(ctx, ly->v_proj, norm);
+            }
+            q = ggml_reshape_3d(ctx, q, D, Nh, NT);
+            k = ggml_reshape_3d(ctx, k, D, Nkv, NT);
+            v = ggml_reshape_3d(ctx, v, D, Nkv, NT);
+            q = ggml_rms_norm(ctx, q, c.rms_norm_eps);
+            q = ggml_mul(ctx, q, qwen3_f32(ctx, ly->q_norm));
+            k = ggml_rms_norm(ctx, k, c.rms_norm_eps);
+            k = ggml_mul(ctx, k, qwen3_f32(ctx, ly->k_norm));
+            q = ggml_rope_ext(ctx, q, positions, NULL, D, 2, 0, c.rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+            k = ggml_rope_ext(ctx, k, positions, NULL, D, 2, 0, c.rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+            if (m->clamp_fp16) {
+                v = ggml_clamp(ctx, v, -65504.0f, 65504.0f);
+            }
+            // [D, X, T*N] -> [D, X, T, N] -> [D, T, X, N]
+            q = ggml_cont(ctx, ggml_permute(ctx, ggml_reshape_4d(ctx, q, D, Nh, T, N), 0, 2, 1, 3));
+            k = ggml_cont(ctx, ggml_permute(ctx, ggml_reshape_4d(ctx, k, D, Nkv, T, N), 0, 2, 1, 3));
+            v = ggml_cont(ctx, ggml_permute(ctx, ggml_reshape_4d(ctx, v, D, Nkv, T, N), 0, 2, 1, 3));
+
+            size_t               off_s0 = (size_t) s0 * m->kv_k4[l]->nb[3];
+            struct ggml_tensor * k_sets = ggml_view_4d(ctx, m->kv_k4[l], D, c.max_seq_len, Nkv, N, m->kv_k4[l]->nb[1],
+                                                       m->kv_k4[l]->nb[2], m->kv_k4[l]->nb[3], off_s0);
+            struct ggml_tensor * v_sets = ggml_view_4d(ctx, m->kv_v4[l], D, c.max_seq_len, Nkv, N, m->kv_v4[l]->nb[1],
+                                                       m->kv_v4[l]->nb[2], m->kv_v4[l]->nb[3], off_s0);
+            ggml_build_forward_expand(gf, ggml_set_rows(ctx, k_sets, k, kv_rows));
+            ggml_build_forward_expand(gf, ggml_set_rows(ctx, v_sets, v, kv_rows));
+
+            struct ggml_tensor * k_batch = ggml_view_4d(ctx, m->kv_k4[l], D, n_kv_pad, Nkv, N, m->kv_k4[l]->nb[1],
+                                                        m->kv_k4[l]->nb[2], m->kv_k4[l]->nb[3], off_s0);
+            struct ggml_tensor * v_batch = ggml_view_4d(ctx, m->kv_v4[l], D, n_kv_pad, Nkv, N, m->kv_v4[l]->nb[1],
+                                                        m->kv_v4[l]->nb[2], m->kv_v4[l]->nb[3], off_s0);
+            float                scale   = 1.0f / sqrtf((float) D);
+            struct ggml_tensor * attn_result =
+                m->use_flash_attn ? ggml_flash_attn_ext(ctx, q, k_batch, v_batch, attn_mask, scale, 0.0f, 0.0f) :
+                                    qwen3_attn_f32(ctx, q, k_batch, v_batch, attn_mask, scale);
+            if (m->use_flash_attn) {
+                ggml_prec_set_acc(attn_result, GGML_PREC_F32);
+            }
+            // [D, Nh, T, N] -> [Nh*D, T*N] (token order n*T + t, same as hidden)
+            struct ggml_tensor * attn_cat = ggml_reshape_2d(ctx, attn_result, Nh * D, NT);
+            hidden                        = ggml_add(ctx, hidden, qwen3_linear(ctx, ly->o_proj, attn_cat));
+            if (m->clamp_fp16) {
+                hidden = ggml_clamp(ctx, hidden, -65504.0f, 65504.0f);
+            }
+            norm   = qwen3_rms_norm(ctx, hidden, ly->post_attn_layernorm, c.rms_norm_eps);
+            hidden = ggml_add(ctx, hidden, qwen3_build_mlp(ctx, ly, norm, NT));
+            if (m->clamp_fp16) {
+                hidden = ggml_clamp(ctx, hidden, -65504.0f, 65504.0f);
+            }
+        }
+        hidden                         = qwen3_rms_norm(ctx, hidden, m->final_norm, c.rms_norm_eps);
+        int                  out_V     = (lm_count > 0) ? lm_count : c.vocab_size;
+        struct ggml_tensor * lm_weight = m->embed_tokens;
+        if (lm_count > 0 && m->lm_head_phase2) {
+            lm_weight = m->lm_head_phase2;
+        } else if (lm_count > 0) {
+            out_V = c.vocab_size;
+        }
+        struct ggml_tensor * lgt = ggml_mul_mat(ctx, lm_weight, hidden);  // [out_V, NT]
+        ggml_set_name(lgt, "logits");
+        ggml_set_output(lgt);
+        ggml_build_forward_expand(gf, lgt);
+        if (!static_graph_alloc(&G.graph, m->backend, m->sched, gf)) {
+            fprintf(stderr, "[LM] FATAL: failed to allocate graph (verify, N=%d, T=%d)\n", N, T);
+            exit(1);
+        }
+        G.gf            = gf;
+        G.token_ids_t   = token_ids_t;
+        G.positions     = positions;
+        G.kv_rows       = kv_rows;
+        G.attn_mask     = attn_mask;
+        G.lgt           = lgt;
+        G.out_V         = out_V;
+        G.key_n_kv_pad  = n_kv_pad;
+        G.key_N         = N;
+        G.key_s0        = s0;
+        G.key_lm_offset = lm_offset;
+        G.key_lm_count  = lm_count;
+        m->verify_key_T = T;
+        G.pos_data.resize((size_t) NT);
+        G.rows_data.resize((size_t) NT);
+        G.mask_data.resize((size_t) n_kv_pad * (size_t) NT);
+        G.built = true;
+    }
+
+    ggml_backend_tensor_set(G.token_ids_t, token_ids, 0, (size_t) NT * sizeof(int));
+    for (int n = 0; n < N; n++) {
+        int p0 = m->kv_pos[s0 + n];
+        for (int t = 0; t < T; t++) {
+            G.pos_data[(size_t) n * T + t]  = p0 + t;
+            G.rows_data[(size_t) n * T + t] = (int64_t) (p0 + t);
+            uint16_t * row                  = G.mask_data.data() + ((size_t) n * T + t) * (size_t) n_kv_pad;
+            for (int j = 0; j < n_kv_pad; j++) {
+                row[j] = ggml_fp32_to_fp16((j <= p0 + t) ? 0.0f : -INFINITY);
+            }
+        }
+    }
+    ggml_backend_tensor_set(G.positions, G.pos_data.data(), 0, (size_t) NT * sizeof(int));
+    ggml_backend_tensor_set(G.kv_rows, G.rows_data.data(), 0, (size_t) NT * sizeof(int64_t));
+    ggml_backend_tensor_set(G.attn_mask, G.mask_data.data(), 0, G.mask_data.size() * sizeof(uint16_t));
+    static_graph_compute(&G.graph, m->backend, m->sched, G.gf);
+    ggml_backend_tensor_get(G.lgt, logits, 0, (size_t) G.out_V * NT * sizeof(float));
+    for (int n = 0; n < N; n++) {
+        m->kv_pos[s0 + n] += T;
+    }
+}
+
 // Free all resources
 static void qw3lm_free(Qwen3LM * m) {
+    static_graph_release(&m->verify_graph.graph, m->sched);
+    graph_arena_free(&m->arena_verify);
     static_graph_release(&m->batch_graph.graph, m->sched);
     graph_arena_free(&m->arena_batch);
     graph_arena_free(&m->arena_decode);
