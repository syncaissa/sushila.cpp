# Llama-3.3-70B-Instruct: the run in the paper (scripts/bench70b/day0_head_70b.sh did it before this pipeline existed).
MODEL=llama3.3-70b
TARGET=casperhansen/llama-3.3-70b-instruct-awq
PUB_HEAD=lmsys/sglang-EAGLE3-LLaMA3.3-Instruct-70B
OLLAMA_TAG=llama3.3:70b
SF_TEMPLATE=llama3
CHAT_KWARGS='{}'
SYSTEM_TURN=1                                # Llama 3.x templates add a system header; training data adds an empty system turn
CTX=2048                                     # the published head declares a 2,048-token context

# Pinned: the exact files behind the published results (from precomputed/llama3.3-70b/CHECKSUMS.json). The pipeline downloads
# these revisions, refuses an Ollama file with another sha256, and RETEST=1 uses HEAD_SHA256 from files.sushila.ai.
# Llama-3.3-70B was measured with scripts/bench70b (docs/REPRODUCE_70B.md); its precomputed head is being rebuilt with
# run_model.sh and is not published yet, so RETEST=1 is not available for it (run the full pipeline).
