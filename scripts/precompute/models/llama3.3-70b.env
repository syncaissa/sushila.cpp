# Llama-3.3-70B-Instruct: the run in the paper (scripts/bench70b/day0_head_70b.sh did it before this pipeline existed).
MODEL=llama3.3-70b
TARGET=casperhansen/llama-3.3-70b-instruct-awq
PUB_HEAD=lmsys/sglang-EAGLE3-LLaMA3.3-Instruct-70B
OLLAMA_TAG=llama3.3:70b
SF_TEMPLATE=llama3
CHAT_KWARGS='{}'
SYSTEM_TURN=1                                # Llama 3.x templates add a system header; training data adds an empty system turn
CTX=2048                                     # the published head declares a 2,048-token context
