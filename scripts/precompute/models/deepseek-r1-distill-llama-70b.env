# PLANNED (not run yet): DeepSeek-R1-Distill-Llama-70B, a reasoning model built on Llama-3.3-70B. One A100/H100 80GB.
# Before running, check on Hugging Face:
#   - a 4-bit file SGLang serves (e.g. an AWQ release of DeepSeek-R1-Distill-Llama-70B);
#   - a published EAGLE-3 head. If there is none, the pipeline needs a "from scratch" path: train the head from random
#     weights on more answers (about 10,000-20,000 instead of 2,000; roughly 2-3x the time). Not built yet.
#   - reasoning output is long (<think> ... </think> then the answer): set max tokens to 1,024+ for the timing runs,
#     and grade GSM8K on the text after </think>.
MODEL=deepseek-r1-distill-llama-70b
TARGET=CHECK-4BIT-REPO                       # e.g. an AWQ release; verify before use
PUB_HEAD=CHECK-EAGLE3-HEAD                   # or empty for training from scratch (pipeline support needed)
OLLAMA_TAG=deepseek-r1:70b
SF_TEMPLATE=llama3                           # verify: R1 distills use their own chat template
CHAT_KWARGS='{}'
SYSTEM_TURN=0
CTX=4096
