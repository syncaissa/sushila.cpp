# CANDIDATE (not run yet): Kimi-Dev-72B (Moonshot AI, MIT license), a coding model fine-tuned from Qwen2.5-72B.
# One A100/H100 80GB at 4 bits (~40 GB). Before running, check on Hugging Face:
#   - a 4-bit file SGLang serves (community AWQ/GPTQ of moonshotai/Kimi-Dev-72B), or make one (AWQ, ~1 h);
#   - a published EAGLE-3 head for Qwen2.5-72B-Instruct to warm-start from (same architecture and tokenizer);
#     our pipeline then refits it to Kimi-Dev's own answers. Without one: the from-scratch path (not built yet).
#   - no official Ollama tag: import a community GGUF into Ollama with a Modelfile (record its sha256);
#   - coding model: train on coding prompts (not Dolly) and time HumanEval-style prompts; outputs are long.
MODEL=kimi-dev-72b
TARGET=CHECK-4BIT-REPO
PUB_HEAD=CHECK-QWEN2.5-72B-EAGLE3-HEAD
OLLAMA_TAG=CHECK-IMPORTED-GGUF
SF_TEMPLATE=qwen
CHAT_KWARGS='{}'
SYSTEM_TURN=0
CTX=4096
