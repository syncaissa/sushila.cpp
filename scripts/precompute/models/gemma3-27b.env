# Gemma 3 27B Instruct (Google, Gemma Terms of Use). One A100/H100 80GB.
# Checked 2026-10-05:
#   - 4-bit for SGLang: gaunernst/gemma-3-27b-it-int4-awq (AWQ conversion of Google's QAT int4 checkpoint; 1M downloads;
#     the published head's author served this kind of file). Multimodal class Gemma3ForConditionalGeneration: weights
#     under language_model.*; the output layer is tied to the embedding (no lm_head tensor).
#   - published EAGLE-3 head: witcheer/gemma-3-27b-eagle3-drafter (Gemma terms; community, trained from scratch on one
#     RTX 5090 for ~25 h on 54k chat/code samples; its card: 1.23-1.52x, 1.6-2.0 tokens accepted per step).
#   - SGLang 0.5.21 supports EAGLE-3 for Gemma 3 (set_eagle3_layers_to_capture); SpecForge 53398a8 has a "gemma" template.
#   - Ollama gemma3:27b = Q4_K_M of the original release (what users run); Ollama's QAT build is a separate tag
#     (gemma3:27b-it-qat). The SGLang file comes from the QAT checkpoint: GSM8K checks answer quality.
MODEL=gemma3-27b
TARGET=gaunernst/gemma-3-27b-it-int4-awq
PUB_HEAD=witcheer/gemma-3-27b-eagle3-drafter
OLLAMA_TAG=gemma3:27b
SF_TEMPLATE=gemma
CHAT_KWARGS='{}'
SYSTEM_TURN=0
CTX=4096
EMBED_KEY=language_model.model.embed_tokens.weight   # Gemma 3 (multimodal checkpoint)
LM_HEAD_KEY=language_model.model.embed_tokens.weight # tied output layer
# Gemma's chat template folds any system prompt into the user turn, and SpecForge's template adds one: train on the
# exact prompt + answer text the model saw instead.
PREFORMAT=1
