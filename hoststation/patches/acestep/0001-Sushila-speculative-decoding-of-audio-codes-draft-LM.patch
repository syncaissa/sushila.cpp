                 mode == LM_MODE_INSPIRE ? "Inspire" : "Format");
+    } else if (!user_has_codes && N == 1 && ctx->params.draft_path && spec_draft(ctx->params.draft_path)) {
+        batch_codes = run_phase2_spec(model, spec_draft(ctx->params.draft_path), ctx->params.spec_k, *bpe, aces[0],
+                                      temperature, top_p, top_k, seeds[0], cfg_scale, neg_prompt, cancel, cancel_data);
+        if (batch_codes.empty()) {
+            return -1;
+        }
     } else if (!user_has_codes) {
         batch_codes = run_phase2_batch(model, *bpe, aces, temperature, top_p, top_k, seeds, cfg_scale, neg_prompt,
                                        ctx->params.use_batch_cfg, cancel, cancel_data);
