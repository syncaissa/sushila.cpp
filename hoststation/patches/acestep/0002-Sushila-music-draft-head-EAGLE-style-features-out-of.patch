+// Sushila: one Qwen3 decoder layer over N consecutive KV sets with T tokens each
+// (hidden [H, N*T], token order n*T + t), writing K/V at kv_rows and attending
+// over the padded window of the 4D cache. Shared by the verification forward and
+// the music draft head.
+static struct ggml_tensor * qw3lm_build_layer_multi(struct ggml_context * ctx,
