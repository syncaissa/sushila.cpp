+
+// ---------------------------------------------------------------------------
+// Sushila: speculative decoding for phase 2 (audio codes), one sequence.
+// ---------------------------------------------------------------------------
+
+// Head layout of a model's phase-2 logits (partial head when available).
+struct SpecHead {
+    int out_V, lm_offset, lm_count, eos_idx, code_offset;
+};
+
+static SpecHead spec_head(const Qwen3LM * m) {
+    int      V       = m->cfg.vocab_size;
+    bool     partial = (m->lm_head_phase2 != NULL);
+    SpecHead h;
+    h.out_V       = partial ? (V - TOKEN_IM_END) : V;
+    h.lm_offset   = partial ? TOKEN_IM_END : 0;
+    h.lm_count    = partial ? (V - TOKEN_IM_END) : 0;
+    h.eos_idx     = partial ? 0 : TOKEN_IM_END;
+    h.code_offset = partial ? (AUDIO_CODE_BASE - TOKEN_IM_END) : AUDIO_CODE_BASE;
+    return h;
+}
+
+// CFG-combined compact logits [EOS, codes...] from one cond (and uncond) row.
+static void spec_compact(const float * lc, const float * lu, bool use_cfg, float cfg_scale, const SpecHead & h,
+                         float * out) {
+    out[0] = use_cfg ? lu[h.eos_idx] + cfg_scale * (lc[h.eos_idx] - lu[h.eos_idx]) : lc[h.eos_idx];
+    for (int c = 0; c < AUDIO_CODE_COUNT; c++) {
+        int idx    = h.code_offset + c;
+        out[c + 1] = use_cfg ? lu[idx] + cfg_scale * (lc[idx] - lu[idx]) : lc[idx];
+    }
+}
+
+// The distribution sample_top_k_p draws from (temperature -> top_k -> top_p ->
+// softmax), as probabilities: logits are modified in place, p[V] filled.
+static void spec_probs(float * logits, int V, float temperature, float top_p, int top_k, float * p) {
+    if (temperature <= 0.0f) {
+        int a = (int) (std::max_element(logits, logits + V) - logits);
+        std::fill(p, p + V, 0.0f);
+        p[a] = 1.0f;
+        return;
+    }
+    static thread_local std::vector<float>     tmp_buf;
+    static thread_local std::vector<TokenProb> sorted_buf;
+    float                                      inv_temp = 1.0f / temperature;
+    for (int i = 0; i < V; i++) {
+        logits[i] *= inv_temp;
+    }
+    if (top_k > 0 && top_k < V) {
+        tmp_buf.assign(logits, logits + V);
+        std::nth_element(tmp_buf.begin(), tmp_buf.begin() + (top_k - 1), tmp_buf.end(), std::greater<float>());
+        float threshold = tmp_buf[top_k - 1];
+        for (int i = 0; i < V; i++) {
+            if (logits[i] < threshold) {
+                logits[i] = -INFINITY;
+            }
+        }
+    }
+    if (top_p > 0.0f && top_p < 1.0f) {
+        float max_logit = -INFINITY;
+        for (int i = 0; i < V; i++) {
+            max_logit = std::max(max_logit, logits[i]);
+        }
+        float sum_exp = 0.0f;
+        for (int i = 0; i < V; i++) {
+            sum_exp += expf(logits[i] - max_logit);
+        }
+        float inv_sum = 1.0f / sum_exp;
+        float cutoff  = max_logit - 16.0f;
+        sorted_buf.clear();
+        for (int i = 0; i < V; i++) {
+            if (logits[i] >= cutoff) {
+                sorted_buf.push_back({ i, expf(logits[i] - max_logit) * inv_sum });
+            } else {
+                logits[i] = -INFINITY;
+            }
+        }
+        int K = (int) sorted_buf.size();
+        if (K > 0) {
+            std::sort(sorted_buf.begin(), sorted_buf.end(),
+                      [](const TokenProb & a, const TokenProb & b) { return a.prob > b.prob; });
+            float cum = 0.0f;
+            for (int i = 0; i < K; i++) {
+                if (i > 0 && cum >= top_p) {
+                    logits[sorted_buf[i].id] = -INFINITY;
+                }
+                cum += sorted_buf[i].prob;
+            }
+        }
+    }
+    float max_val = -INFINITY;
+    for (int i = 0; i < V; i++) {
+        max_val = std::max(max_val, logits[i]);
+    }
+    double sum = 0.0;
+    for (int i = 0; i < V; i++) {
+        p[i] = expf(logits[i] - max_val);
+        sum += p[i];
+    }
+    float inv = (float) (1.0 / sum);
+    for (int i = 0; i < V; i++) {
+        p[i] *= inv;
+    }
+}
+
+static int spec_draw(const float * p, int V, std::mt19937 & rng) {
+    std::uniform_real_distribution<float> dist(0.0f, 1.0f);
+    float                                 r = dist(rng), acc = 0.0f;
+    int                                   last = 0;
+    for (int i = 0; i < V; i++) {
+        if (p[i] > 0.0f) {
+            acc += p[i];
+            last = i;
+            if (acc >= r) {
+                return i;
+            }
+        }
+    }
+    return last;
+}
+
+static int spec_to_token(int c) {
+    return c == 0 ? TOKEN_IM_END : AUDIO_CODE_BASE + c - 1;
+}
+
+static int spec_to_compact(int tok) {
+    return tok == TOKEN_IM_END ? 0 : tok - AUDIO_CODE_BASE + 1;
+}
+
+// The draft LM, loaded once and kept (small: the 0.6B LM is ~0.7 GB in Q8_0).
+static Qwen3LM * spec_draft(const char * path) {
+    static Qwen3LM *   g_draft = nullptr;
+    static std::string g_path;
+    static bool        g_failed = false;
+    if (g_draft && g_path == path) {
+        return g_draft;
+    }
+    if (g_failed && g_path == path) {
+        return nullptr;
+    }
+    if (g_draft) {
+        qw3lm_free(g_draft);
+        delete g_draft;
+        g_draft = nullptr;
+    }
+    g_path    = path;
+    Timer t;
+    Qwen3LM * d = new Qwen3LM();
+    if (!qw3lm_load(d, path, 4096, 2)) {
+        fprintf(stderr, "[LM-Spec] draft load failed: %s (speculative decoding off)\n", path);
+        delete d;
+        g_failed = true;
+        return nullptr;
+    }
+    qw3lm_build_partial_head(d, TOKEN_IM_END);
+    g_draft = d;
+    fprintf(stderr, "[LM-Spec] draft loaded: %s, %d layers, %.0f ms\n", path, d->cfg.n_layers, t.ms());
+    return g_draft;
+}
+
+// Phase 2 for N == 1 with a draft LM. Same prompts and sampling settings as
+// run_phase2_batch; output follows the main LM's sampling distribution (a
+// different draw than the plain loop for the same seed).
+static std::vector<std::string> run_phase2_spec(Qwen3LM *         m,
+                                                Qwen3LM *         d,
+                                                int               spec_k,
+                                                BPETokenizer &    bpe,
+                                                const AcePrompt & a,
+                                                float             temperature,
+                                                float             top_p,
+                                                int               top_k,
+                                                uint32_t          seed,
+                                                float             cfg_scale,
+                                                const char *      negative_prompt,
+                                                bool (*cancel)(void *),
+                                                void * cancel_data) {
+    const int  V       = m->cfg.vocab_size;
+    const bool use_cfg = cfg_scale > 1.0f;
+    const int  S       = use_cfg ? 2 : 1;  // KV sets: 0 cond, 1 uncond
+    const int  CV      = AUDIO_CODE_COUNT + 1;
+    if (spec_k < 1) {
+        spec_k = 1;
+    }
+    if (spec_k > 16) {
+        spec_k = 16;
+    }
+
+    std::string      cot    = build_cot_yaml(a);
+    std::vector<int> prompt = build_lm_prompt_with_cot(bpe, a, cot);
+    std::vector<int> uncond;
+    if (use_cfg) {
+        uncond = build_lm_prompt_uncond_with_cot(bpe, negative_prompt);
+    }
+    int max_tokens = (int) (a.duration * 5) + 100;
+    fprintf(stderr, "[LM-Spec] max_tokens: %d, CFG: %.2f, k=%d, draft %d layers\n", max_tokens, cfg_scale, spec_k,
+            d->cfg.n_layers);
+
+    Timer t_prefill;
+    for (int s = 0; s < S; s++) {
+        qw3lm_reset_kv(m, s);
+        qw3lm_reset_kv(d, s);
+    }
+    std::vector<float> lg(V), lu(V), dl(d->cfg.vocab_size);
+    qw3lm_forward(m, prompt.data(), (int) prompt.size(), 0, lg.data());
+    qw3lm_forward(d, prompt.data(), (int) prompt.size(), 0, dl.data());
+    if (use_cfg) {
+        qw3lm_forward(m, uncond.data(), (int) uncond.size(), 1, lu.data());
+        qw3lm_forward(d, uncond.data(), (int) uncond.size(), 1, dl.data());
+    }
+    fprintf(stderr, "[LM-Spec] Prefill %.0fms (main + draft)\n", t_prefill.ms());
+
+    std::mt19937 rng(seed);
+    // First code from the main LM's prefill logits, as in run_phase2_batch.
+    std::vector<float> cl(CV), pbuf(CV);
+    {
+        SpecHead full = { V, 0, 0, TOKEN_IM_END, AUDIO_CODE_BASE };
+        spec_compact(lg.data(), lu.data(), use_cfg, cfg_scale, full, cl.data());
+        spec_probs(cl.data(), CV, temperature, top_p, top_k, pbuf.data());
+    }
+    int              last = spec_to_token(spec_draw(pbuf.data(), CV, rng));
+    std::vector<int> codes;
+    bool             done = (last == TOKEN_IM_END);
+    if (!done) {
+        codes.push_back(last - AUDIO_CODE_BASE);
+    }
+
+    const SpecHead hm = spec_head(m), hd = spec_head(d);
+    // draft: tokens still to feed before it drafts (the last accepted one, plus
+    // the final draft when every draft was accepted)
+    std::vector<int>   dpend = { last };
+    std::vector<float> dlog((size_t) hd.out_V * S);
+    std::vector<float> vlog((size_t) hm.out_V * S * (spec_k + 1));
+    std::vector<float> Q((size_t) CV * spec_k), P((size_t) CV * (spec_k + 1));
+    std::vector<int>   drafts(spec_k), vtok((size_t) S * (spec_k + 1));
+    std::uniform_real_distribution<float> U(0.0f, 1.0f);
+
+    long   rounds = 0, drafted = 0, accepted = 0;
+    Timer  t_decode;
+    double t_draft = 0, t_verify = 0;
+    while (!done && (int) codes.size() < max_tokens) {
+        if (cancel && cancel(cancel_data)) {
+            fprintf(stderr, "[LM-Spec] Cancelled\n");
+            return {};
+        }
+        int remaining = max_tokens - (int) codes.size();
+        int k         = std::min(spec_k, remaining);
+        // 1. draft k codes
+        Timer td;
+        int   dbase[2] = { d->kv_pos[0], d->kv_pos[1] };
+        int   tok2[2], sets2[2] = { 0, 1 };
+        for (size_t j = 0; j + 1 < dpend.size(); j++) {
+            tok2[0] = tok2[1] = dpend[j];
+            qw3lm_forward_batch(d, tok2, sets2, S, dlog.data(), hd.lm_offset, hd.lm_count);
+        }
+        int x  = dpend.back();
+        int ke = 0;
+        for (int j = 0; j < k; j++) {
+            tok2[0] = tok2[1] = x;
+            qw3lm_forward_batch(d, tok2, sets2, S, dlog.data(), hd.lm_offset, hd.lm_count);
+            spec_compact(dlog.data(), dlog.data() + hd.out_V, use_cfg, cfg_scale, hd, cl.data());
+            float * q = Q.data() + (size_t) j * CV;
+            spec_probs(cl.data(), CV, temperature, top_p, top_k, q);
+            int c     = spec_draw(q, CV, rng);
+            drafts[j] = spec_to_token(c);
+            x         = drafts[j];
+            ke        = j + 1;
+            if (x == TOKEN_IM_END) {
+                break;
+            }
+        }
+        t_draft += td.ms();
+        // 2. verify [last, d1..dke] on the main LM, all positions at once
+        Timer     tv;
+        const int T     = ke + 1;
+        int       mbase = m->kv_pos[0];
+        int       ubase = use_cfg ? m->kv_pos[1] : 0;
+        for (int s = 0; s < S; s++) {
+            vtok[(size_t) s * T] = last;
+            for (int j = 0; j < ke; j++) {
+                vtok[(size_t) s * T + 1 + j] = drafts[j];
+            }
+        }
+        qw3lm_forward_verify(m, vtok.data(), 0, S, T, vlog.data(), hm.lm_offset, hm.lm_count);
+        for (int t = 0; t < T; t++) {
+            const float * lc = vlog.data() + (size_t) t * hm.out_V;
+            const float * lw = use_cfg ? vlog.data() + (size_t) (T + t) * hm.out_V : lc;
+            spec_compact(lc, lw, use_cfg, cfg_scale, hm, cl.data());
+            spec_probs(cl.data(), CV, temperature, top_p, top_k, P.data() + (size_t) t * CV);
+        }
+        t_verify += tv.ms();
+        // 3. accept / reject (speculative sampling)
+        int acc = 0, next = -1;
+        for (int j = 0; j < ke; j++) {
+            const float * p  = P.data() + (size_t) j * CV;
+            const float * q  = Q.data() + (size_t) j * CV;
+            int           c  = spec_to_compact(drafts[j]);
+            float         pa = p[c], qa = q[c];
+            if (qa > 0.0f && U(rng) * qa <= pa) {
+                acc++;
+                continue;
+            }
+            // rejected: draw from the residual max(0, p - q)
+            double z = 0.0;
+            for (int i = 0; i < CV; i++) {
+                pbuf[i] = std::max(0.0f, p[i] - q[i]);
+                z += pbuf[i];
+            }
+            if (z <= 0.0) {
+                std::copy(p, p + CV, pbuf.begin());
+            } else {
+                float inv = (float) (1.0 / z);
+                for (int i = 0; i < CV; i++) {
+                    pbuf[i] *= inv;
+                }
+            }
+            next = spec_to_token(spec_draw(pbuf.data(), CV, rng));
+            break;
+        }
+        if (next < 0) {  // all accepted: bonus code from the last position
+            next = spec_to_token(spec_draw(P.data() + (size_t) ke * CV, CV, rng));
+        }
+        rounds++;
+        drafted += ke;
+        accepted += acc;
+        // 4. emit accepted drafts, then the corrected / bonus code
+        for (int j = 0; j < acc && !done; j++) {
+            if (drafts[j] == TOKEN_IM_END) {
+                done = true;
+            } else {
+                codes.push_back(drafts[j] - AUDIO_CODE_BASE);
+            }
+        }
+        if (!done) {
+            if (next == TOKEN_IM_END) {
+                done = true;
+            } else if ((int) codes.size() < max_tokens) {
+                codes.push_back(next - AUDIO_CODE_BASE);
+            }
+        }
+        // 5. roll back both KV caches to the accepted prefix
+        m->kv_pos[0] = mbase + 1 + acc;
+        if (use_cfg) {
+            m->kv_pos[1] = ubase + 1 + acc;
+        }
+        for (int s = 0; s < S; s++) {
+            d->kv_pos[s] = dbase[s] + (int) dpend.size() + std::min(acc, ke - 1);
+        }
+        last = next;
+        if (acc == ke) {
+            dpend = { drafts[ke - 1], next };
+        } else {
+            dpend = { next };
+        }
+    }
+    double ms = t_decode.ms();
+    fprintf(stderr,
+            "[LM-Spec] Decode %.0fms, %zu codes, %.1f codes/s | rounds %ld, drafted %ld, accepted %ld (%.0f%%), "
+            "%.2f codes/round | draft %.0fms, verify+sample %.0fms\n",
+            ms, codes.size(), codes.size() / (ms / 1000.0), rounds, drafted, accepted,
+            drafted ? 100.0 * accepted / drafted : 0.0, rounds ? (double) (codes.size()) / rounds : 0.0, t_draft,
+            t_verify);
+    return { codes_to_string(codes) };
+}
+
