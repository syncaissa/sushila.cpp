     return tok == TOKEN_IM_END ? 0 : tok - AUDIO_CODE_BASE + 1;
 }
 
+// The music draft head, loaded once per main LM and kept.
+static MusicHead * spec_head_for(Qwen3LM * m, const char * path) {
+    static MusicHead * g_head = nullptr;
+    static Qwen3LM *   g_m    = nullptr;
+    static std::string g_path;
+    if (g_head && g_m == m && g_path == path) {
+        return g_head;
+    }
+    if (g_head) {
+        mhead_free(g_head);
+        delete g_head;
+        g_head = nullptr;
+    }
+    Timer       t;
+    MusicHead * h = new MusicHead();
+    if (!mhead_load(h, m, path)) {
+        fprintf(stderr, "[LM-Head] head load failed: %s (speculative decoding off)\n", path);
+        delete h;
+        return nullptr;
+    }
+    g_head = h;
+    g_m    = m;
+    g_path = path;
+    fprintf(stderr, "[LM-Head] music draft head loaded: %s, %.0f ms\n", path, t.ms());
+    return g_head;
+}
+
+// Phase 2 for N == 1 with the music draft head (EAGLE-style). Same prompts and
+// sampling as run_phase2_batch; the output follows the main LM's distribution.
+static std::vector<std::string> run_phase2_head(Qwen3LM *         m,
+                                                MusicHead *       hd,
+                                                int               spec_k,
+                                                BPETokenizer &    bpe,
+                                                const AcePrompt & a,
+                                                float             temperature,
+                                                float             top_p,
+                                                int               top_k,
+                                                uint32_t          seed,
+                                                float             cfg_scale,
+                                                const char *      negative_prompt,
+                                                bool (*cancel)(void *),
+                                                void * cancel_data) {
+    const int  V       = m->cfg.vocab_size;
+    const int  H       = m->cfg.hidden_size;
+    const bool use_cfg = cfg_scale > 1.0f;
+    const int  S       = use_cfg ? 2 : 1;
+    const int  CV      = AUDIO_CODE_COUNT + 1;
+    spec_k             = std::max(1, std::min(spec_k, 16));
+
+    std::string      cot = build_cot_yaml(a);
+    std::vector<int> pr[2];
+    pr[0] = build_lm_prompt_with_cot(bpe, a, cot);
+    if (use_cfg) {
+        pr[1] = build_lm_prompt_uncond_with_cot(bpe, negative_prompt);
+    }
+    int max_tokens = (int) (a.duration * 5) + 100;
+    fprintf(stderr, "[LM-Head] max_tokens: %d, CFG: %.2f, k=%d\n", max_tokens, cfg_scale, spec_k);
+
+    const SpecHead hm = spec_head(m);
+    Timer          t_prefill;
+    std::vector<float> lgp[2] = { std::vector<float>(V), std::vector<float>(V) };
+    std::vector<float> fpre[2];
+    for (int s = 0; s < S; s++) {
+        qw3lm_reset_kv(m, s);
+        hd->kv_pos[s] = 0;
+        fpre[s].resize((size_t) H * pr[s].size());
+        qw3lm_forward(m, pr[s].data(), (int) pr[s].size(), s, lgp[s].data(), fpre[s].data());
+    }
+    std::mt19937       rng(seed);
+    std::vector<float> cl(CV), pbuf(CV);
+    {
+        SpecHead full = { V, 0, 0, TOKEN_IM_END, AUDIO_CODE_BASE };
+        spec_compact(lgp[0].data(), lgp[use_cfg ? 1 : 0].data(), use_cfg, cfg_scale, full, cl.data());
+        spec_probs(cl.data(), CV, temperature, top_p, top_k, pbuf.data());
+    }
+    int              last = spec_to_token(spec_draw(pbuf.data(), CV, rng));
+    std::vector<int> codes;
+    bool             done = (last == TOKEN_IM_END);
+    if (!done) {
+        codes.push_back(last - AUDIO_CODE_BASE);
+    }
+    // head prefill: entry t = (f_t, x_{t+1}) over the prompt, x_P = the first code
+    std::vector<float> hlog((size_t) hm.out_V * S), g((size_t) H * S), gtmp;
+    for (int s = 0; s < S && !done; s++) {
+        int              P = (int) pr[s].size();
+        std::vector<int> nx(pr[s].begin() + 1, pr[s].end());
+        nx.push_back(last);
+        gtmp.resize((size_t) H * P);
+        mhead_forward(hd, s, fpre[s].data(), nx.data(), 1, P, P, P - 1, gtmp.data(), hlog.data() + (size_t) s * hm.out_V,
+                      hm.lm_offset, hm.lm_count);
+        std::copy(gtmp.begin() + (size_t) (P - 1) * H, gtmp.begin() + (size_t) P * H, g.begin() + (size_t) s * H);
+    }
+    fprintf(stderr, "[LM-Head] Prefill %.0fms (main + head)\n", t_prefill.ms());
+
+    const int          K1 = spec_k + 1;
+    std::vector<float> vlog((size_t) hm.out_V * S * K1), vfeat((size_t) H * S * K1), efeat((size_t) H * S * K1),
+        eout((size_t) H * S * K1);
+    std::vector<float> Q((size_t) CV * spec_k), P((size_t) CV * K1);
+    std::vector<int>   drafts(spec_k), vtok((size_t) S * K1), etok((size_t) S * K1), tok2(2);
+    std::uniform_real_distribution<float> U(0.0f, 1.0f);
+    long   rounds = 0, drafted = 0, accepted = 0;
+    double t_draft = 0, t_verify = 0, t_sample = 0, t_extend = 0;
+    Timer  t_decode;
+    while (!done && (int) codes.size() < max_tokens) {
+        if (cancel && cancel(cancel_data)) {
+            fprintf(stderr, "[LM-Head] Cancelled\n");
+            return {};
+        }
+        const int k = std::min(spec_k, max_tokens - (int) codes.size());
+        // 1. draft with the head; its first distribution came with the last extend
+        Timer td;
+        int   hbase[2] = { hd->kv_pos[0], hd->kv_pos[1] };
+        int   ke       = 0;
+        for (int j = 0; j < k; j++) {
+            if (j > 0) {
+                for (int s = 0; s < S; s++) {
+                    tok2[s] = drafts[j - 1];
+                }
+                std::vector<float> gin(g);
+                mhead_forward(hd, 0, gin.data(), tok2.data(), S, 1, 1, 0, g.data(), hlog.data(), hm.lm_offset,
+                              hm.lm_count);
+            }
+            spec_compact(hlog.data(), hlog.data() + (use_cfg ? hm.out_V : 0), use_cfg, cfg_scale, hm, cl.data());
+            float * q = Q.data() + (size_t) j * CV;
+            spec_probs(cl.data(), CV, temperature, top_p, top_k, q);
+            drafts[j] = spec_to_token(spec_draw(q, CV, rng));
+            ke        = j + 1;
+            if (drafts[j] == TOKEN_IM_END) {
+                break;
+            }
+        }
+        t_draft += td.ms();
+        // 2. verify [last, d1..dke] on the main LM (logits and features)
+        Timer     tv;
+        const int T        = ke + 1;
+        int       mbase[2] = { m->kv_pos[0], m->kv_pos[1] };
+        for (int s = 0; s < S; s++) {
+            vtok[(size_t) s * T] = last;
+            for (int j = 0; j < ke; j++) {
+                vtok[(size_t) s * T + 1 + j] = drafts[j];
+            }
+        }
+        qw3lm_forward_verify(m, vtok.data(), 0, S, T, vlog.data(), hm.lm_offset, hm.lm_count, vfeat.data());
+        t_verify += tv.ms();
+        // 3. accept / reject
+        Timer ts;
+        auto  target_probs = [&](int t) {
+            const float * lc = vlog.data() + (size_t) t * hm.out_V;
+            const float * lw = use_cfg ? vlog.data() + (size_t) (T + t) * hm.out_V : lc;
+            spec_compact(lc, lw, use_cfg, cfg_scale, hm, cl.data());
+            spec_probs(cl.data(), CV, temperature, top_p, top_k, P.data() + (size_t) t * CV);
+            return P.data() + (size_t) t * CV;
+        };
+        int acc = 0, next = -1;
+        for (int j = 0; j < ke; j++) {
+            const float * p = target_probs(j);
+            const float * q = Q.data() + (size_t) j * CV;
+            int           c = spec_to_compact(drafts[j]);
+            if (q[c] > 0.0f && U(rng) * q[c] <= p[c]) {
+                acc++;
+                continue;
+            }
+            double z = 0.0;
+            for (int i = 0; i < CV; i++) {
+                pbuf[i] = std::max(0.0f, p[i] - q[i]);
+                z += pbuf[i];
+            }
+            if (z <= 0.0) {
+                std::copy(p, p + CV, pbuf.begin());
+            } else {
+                for (int i = 0; i < CV; i++) {
+                    pbuf[i] = (float) (pbuf[i] / z);
+                }
+            }
+            next = spec_to_token(spec_draw(pbuf.data(), CV, rng));
+            break;
+        }
+        if (next < 0) {
+            next = spec_to_token(spec_draw(target_probs(ke), CV, rng));
+        }
+        t_sample += ts.ms();
+        rounds++;
+        drafted += ke;
+        accepted += acc;
+        for (int j = 0; j < acc && !done; j++) {
+            if (drafts[j] == TOKEN_IM_END) {
+                done = true;
+            } else {
+                codes.push_back(drafts[j] - AUDIO_CODE_BASE);
+            }
+        }
+        if (!done) {
+            if (next == TOKEN_IM_END) {
+                done = true;
+            } else if ((int) codes.size() < max_tokens) {
+                codes.push_back(next - AUDIO_CODE_BASE);
+            }
+        }
+        for (int s = 0; s < S; s++) {
+            m->kv_pos[s] = mbase[s] + 1 + acc;
+        }
+        last = next;
+        if (done) {
+            break;
+        }
+        // 4. head: drop its own drafts, extend with the main LM's features of the
+        // accepted positions (padded to k + 1 entries); the last one drafts next
+        Timer te;
+        for (int s = 0; s < S; s++) {
+            hd->kv_pos[s] = hbase[s];
+        }
+        const int TE = K1;
+        for (int s = 0; s < S; s++) {
+            for (int t = 0; t < TE; t++) {
+                int src = std::min(t, T - 1);
+                std::copy(vfeat.begin() + ((size_t) s * T + src) * H, vfeat.begin() + ((size_t) s * T + src + 1) * H,
+                          efeat.begin() + ((size_t) s * TE + t) * H);
+                etok[(size_t) s * TE + t] = t < acc ? drafts[t] : next;
+            }
+        }
+        mhead_forward(hd, 0, efeat.data(), etok.data(), S, TE, acc + 1, acc, eout.data(), hlog.data(), hm.lm_offset,
+                      hm.lm_count);
+        for (int s = 0; s < S; s++) {
+            std::copy(eout.begin() + ((size_t) s * TE + acc) * H, eout.begin() + ((size_t) s * TE + acc + 1) * H,
+                      g.begin() + (size_t) s * H);
+        }
+        t_extend += te.ms();
+    }
+    double ms = t_decode.ms();
+    fprintf(stderr,
+            "[LM-Head] Decode %.0fms, %zu codes, %.1f codes/s | rounds %ld, drafted %ld, accepted %ld (%.0f%%), "
+            "%.2f codes/round | draft %.0fms, verify %.0fms, accept/sample %.0fms, extend %.0fms\n",
+            ms, codes.size(), codes.size() / (ms / 1000.0), rounds, drafted, accepted,
+            drafted ? 100.0 * accepted / drafted : 0.0, rounds ? (double) codes.size() / rounds : 0.0, t_draft,
+            t_verify, t_sample, t_extend);
+    return { codes_to_string(codes) };
+}
+
 // The draft LM, loaded once and kept (small: the 0.6B LM is ~0.7 GB in Q8_0).
 static Qwen3LM * spec_draft(const char * path) {
     static Qwen3LM *   g_draft = nullptr;
@@ -800,7 +1081,7 @@ static std::vector<std::string> run_phase2_spec(Qwen3LM *         m,
 
     long   rounds = 0, drafted = 0, accepted = 0;
     Timer  t_decode;
-    double t_draft = 0, t_verify = 0;
+    double t_draft = 0, t_verify = 0, t_sample = 0;
     while (!done && (int) codes.size() < max_tokens) {
         if (cancel && cancel(cancel_data)) {
             fprintf(stderr, "[LM-Spec] Cancelled\n");
@@ -845,17 +1126,20 @@ static std::vector<std::string> run_phase2_spec(Qwen3LM *         m,
             }
         }
         qw3lm_forward_verify(m, vtok.data(), 0, S, T, vlog.data(), hm.lm_offset, hm.lm_count);
-        for (int t = 0; t < T; t++) {
+        t_verify += tv.ms();
+        Timer ts;
+        // main LM's distribution at position t, computed only when needed
+        auto target_probs = [&](int t) {
             const float * lc = vlog.data() + (size_t) t * hm.out_V;
             const float * lw = use_cfg ? vlog.data() + (size_t) (T + t) * hm.out_V : lc;
             spec_compact(lc, lw, use_cfg, cfg_scale, hm, cl.data());
             spec_probs(cl.data(), CV, temperature, top_p, top_k, P.data() + (size_t) t * CV);
-        }
-        t_verify += tv.ms();
+            return P.data() + (size_t) t * CV;
+        };
         // 3. accept / reject (speculative sampling)
         int acc = 0, next = -1;
         for (int j = 0; j < ke; j++) {
-            const float * p  = P.data() + (size_t) j * CV;
+            const float * p  = target_probs(j);
             const float * q  = Q.data() + (size_t) j * CV;
             int           c  = spec_to_compact(drafts[j]);
             float         pa = p[c], qa = q[c];
@@ -881,8 +1165,9 @@ static std::vector<std::string> run_phase2_spec(Qwen3LM *         m,
             break;
         }
         if (next < 0) {  // all accepted: bonus code from the last position
-            next = spec_to_token(spec_draw(P.data() + (size_t) ke * CV, CV, rng));
+            next = spec_to_token(spec_draw(target_probs(ke), CV, rng));
         }
+        t_sample += ts.ms();
         rounds++;
         drafted += ke;
         accepted += acc;
@@ -919,10 +1204,10 @@ static std::vector<std::string> run_phase2_spec(Qwen3LM *         m,
     double ms = t_decode.ms();
     fprintf(stderr,
             "[LM-Spec] Decode %.0fms, %zu codes, %.1f codes/s | rounds %ld, drafted %ld, accepted %ld (%.0f%%), "
-            "%.2f codes/round | draft %.0fms, verify+sample %.0fms\n",
+            "%.2f codes/round | draft %.0fms, verify %.0fms, accept/sample %.0fms\n",
             ms, codes.size(), codes.size() / (ms / 1000.0), rounds, drafted, accepted,
             drafted ? 100.0 * accepted / drafted : 0.0, rounds ? (double) (codes.size()) / rounds : 0.0, t_draft,
-            t_verify);
+            t_verify, t_sample);
     return { codes_to_string(codes) };
 }
 
