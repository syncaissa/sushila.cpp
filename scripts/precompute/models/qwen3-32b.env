# Qwen3-32B (dense). One A100 80GB.
MODEL=qwen3-32b
TARGET=Qwen/Qwen3-32B-AWQ                    # 4-bit file served by SGLang
PUB_HEAD=thoughtworks/Qwen3-32B-Eagle3        # published EAGLE-3 head we start from (Apache-2.0). Not AngelSlim/Qwen3-32B_eagle3:
                                             # its attention heads are 80 wide (the model's are 128) and SGLang 0.5.21 crashes
                                             # (illegal memory access while capturing the draft's CUDA graphs)
OLLAMA_TAG=qwen3:32b                         # what Ollama users run (Q4_K_M)
SF_TEMPLATE=qwen                             # SpecForge chat template
CHAT_KWARGS='{"enable_thinking": false}'     # non-thinking mode everywhere (prompts, answers, training, Ollama)
SYSTEM_TURN=0                                # Qwen3's template adds no default system turn
