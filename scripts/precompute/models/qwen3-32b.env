# Qwen3-32B (dense). One A100 80GB.
MODEL=qwen3-32b
TARGET=Qwen/Qwen3-32B-AWQ                    # 4-bit file served by SGLang
PUB_HEAD=thoughtworks/Qwen3-32B-Eagle3        # published EAGLE-3 head we start from (Apache-2.0). Not AngelSlim/Qwen3-32B_eagle3:
                                             # its attention heads are 80 wide (the model's are 128) and SGLang 0.5.21 crashes
                                             # (illegal memory access while capturing the draft's CUDA graphs)
OLLAMA_TAG=qwen3:32b                         # what Ollama users run (Q4_K_M)
SF_TEMPLATE=qwen                             # SpecForge chat template
CHAT_KWARGS='{"enable_thinking": false}'     # non-thinking mode everywhere (prompts, answers, training, Ollama)
SYSTEM_TURN=0                                # Qwen3's template adds no default system turn

# Pinned: the exact files behind the published results (from precomputed/qwen3-32b/CHECKSUMS.json). The pipeline downloads
# these revisions, refuses an Ollama file with another sha256, and RETEST=1 uses HEAD_SHA256 from files.sushila.ai.
TARGET_REV=0499c3ac83fdef8810b907a23894ba91e95eddd8
PUB_HEAD_REV=ba10360e72cc5208048695e713c2d45781921013
OLLAMA_SHA256=3291abe70f16ee9682de7bfae08db5373ea9d6497e614aaad63340ad421d6312
HEAD_SHA256=ff4aa38997cea15a3c16f6d63e09b9d41488a529b9ae08c3d05500b64db9b899
HEAD_CONFIG_SHA256=cf74feeae23857e70b21ab9747ab8ea4bc01b79c424f2bdfce7791bfb445062f
