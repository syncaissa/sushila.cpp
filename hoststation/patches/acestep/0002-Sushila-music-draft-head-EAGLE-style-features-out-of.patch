+// sushila-music-head.h : Sushila draft head for the ACE-Step song-writing LM (GGML)
+//
+// One Qwen3 decoder layer on top of the main LM (EAGLE-style feature drafting):
+// entry t takes the main LM's pre-norm last-layer feature f_t and the embedding
+// of token x_{t+1}, and predicts f_{t+1}; the main LM's final norm and partial
+// (audio code) head turn the prediction into the distribution of x_{t+2}.
+// It runs on the main LM's backend and reuses its embedding, final norm and head;
+// its own KV cache has one set per CFG branch (0 cond, 1 uncond).
+// Trained once per model by scripts/music/train_music_head.py.
+#pragma once
+
+#include "qwen3-lm.h"
+
+struct MusicHead {
+    Qwen3LM *            m;  // main LM (not owned)
+    struct ggml_tensor * fc;  // [2H, H]
+    Qwen3Layer           layer;
+    WeightCtx            wctx;
+
+    struct ggml_context * kv_ctx;
+    ggml_backend_buffer_t kv_buf;
+    struct ggml_tensor *  kv_k4;  // [D, max_seq, Nkv, 2]
+    struct ggml_tensor *  kv_v4;
+    int                   kv_pos[2];
+    int                   max_seq;
+
+    // two replayed graphs: single-entry drafting (T = 1) and multi-entry extend
+    GraphArena      arena[2];
+    Qw3lmGraphCache g[2];
+    int             key_T[2];
+    int             key_s0[2];
+    ggml_tensor *   feat_in_t[2];
+    ggml_tensor *   pick_t[2];
+};
+
+static bool mhead_load(MusicHead * h, Qwen3LM * m, const char * path) {
+    *h      = {};
+    h->m    = m;
+    GGUFModel gf;
+    if (!gf_load(&gf, path)) {
+        fprintf(stderr, "[MusicHead] cannot load %s\n", path);
+        return false;
+    }
+    wctx_init(&h->wctx, 16);
+    h->fc = gf_load_tensor(&h->wctx, gf, "fc.weight");
+    qwen3_load_layer(&h->wctx, gf, &h->layer, "model.layers.0", 1);
+    wctx_alloc(&h->wctx, m->backend);
+    gf_close(&gf);
+    if (!h->fc || h->fc->ne[0] != 2 * m->cfg.hidden_size || h->fc->ne[1] != m->cfg.hidden_size) {
+        fprintf(stderr, "[MusicHead] %s does not match this LM (hidden %d)\n", path, m->cfg.hidden_size);
+        return false;
+    }
+
+    const Qwen3LMConfig & c = m->cfg;
+    h->max_seq              = c.max_seq_len;
+    struct ggml_init_params ip = { 4 * ggml_tensor_overhead(), NULL, true };
+    h->kv_ctx                  = ggml_init(ip);
+    h->kv_k4 = ggml_new_tensor_4d(h->kv_ctx, GGML_TYPE_F16, c.head_dim, h->max_seq, c.n_kv_heads, 2);
+    h->kv_v4 = ggml_new_tensor_4d(h->kv_ctx, GGML_TYPE_F16, c.head_dim, h->max_seq, c.n_kv_heads, 2);
+    h->kv_buf = ggml_backend_alloc_ctx_tensors(h->kv_ctx, m->backend);
+    if (!h->kv_buf) {
+        return false;
+    }
+    ggml_backend_buffer_clear(h->kv_buf, 0);
+    for (int i = 0; i < 2; i++) {
+        if (!graph_arena_init(&h->arena[i], 4096)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void mhead_free(MusicHead * h) {
+    for (int i = 0; i < 2; i++) {
+        static_graph_release(&h->g[i].graph, h->m->sched);
+        graph_arena_free(&h->arena[i]);
+    }
+    if (h->kv_buf) {
+        ggml_backend_buffer_free(h->kv_buf);
+    }
+    if (h->kv_ctx) {
+        ggml_free(h->kv_ctx);
+    }
+    wctx_free(&h->wctx);
+    *h = {};
+}
+
+// Append T entries to each of the S branches: feats[(s*T + t) * H] (main LM
+// features or the head's own predictions) and tokens[s*T + t] (the token after
+// each feature's position). Writes the head's predicted features feat_out[(s*T + t) * H]
+// and, for entry `row` of every branch, the head-window logits into
+// logits[s * out_V]. Entries past `used` are padding (written, then rolled back).
+static void mhead_forward(MusicHead *   h,
+                          int           s0,
+                          const float * feats,
+                          const int *   tokens,
+                          int           S,
+                          int           T,
+                          int           used,
+                          int           row,
+                          float *       feat_out,
+                          float *       logits,
+                          int           lm_offset,
+                          int           lm_count) {
+    Qwen3LM *             m  = h->m;
+    const Qwen3LMConfig & c  = m->cfg;
+    const int             H  = c.hidden_size;
+    const int             NT = S * T;
+    const int             gi = T == 1 ? 0 : 1;
+
+    int max_kv_len = 0;
+    for (int s = s0; s < s0 + S; s++) {
+        int kl = h->kv_pos[s] + T;
+        if (kl > h->max_seq) {
+            fprintf(stderr, "[MusicHead] FATAL: kv_len %d > max_seq %d\n", kl, h->max_seq);
+            exit(1);
+        }
+        max_kv_len = kl > max_kv_len ? kl : max_kv_len;
+    }
+    const int kv_pad_raw = (int) GGML_PAD(max_kv_len, 256);
+    const int n_kv_pad   = kv_pad_raw < h->max_seq ? kv_pad_raw : h->max_seq;
+
+    // the main LM's replayed graphs keep their own allocators; only a scheduler
+    // fallback shares state, and the main LM releases those itself
+    Qw3lmGraphCache & G = h->g[gi];
+    const bool need_build = !G.built || G.key_n_kv_pad != n_kv_pad || G.key_N != S || h->key_T[gi] != T || h->key_s0[gi] != s0 ||
+                            G.key_lm_offset != lm_offset || G.key_lm_count != lm_count;
+    if (need_build) {
+        static_graph_release(&G.graph, m->sched);
+        G.built                   = false;
+        struct ggml_context * ctx = graph_arena_begin(&h->arena[gi]);
+        struct ggml_cgraph *  gf  = ggml_new_graph_custom(ctx, 4096, false);
+
+        struct ggml_tensor * feat_in = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, H, NT);
+        ggml_set_name(feat_in, "head_feat_in");
+        ggml_set_input(feat_in);
+        struct ggml_tensor * token_ids_t = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, NT);
+        ggml_set_input(token_ids_t);
+        struct ggml_tensor * positions = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, NT);
+        ggml_set_input(positions);
+        struct ggml_tensor * attn_mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, n_kv_pad, T, 1, S);
+        ggml_set_input(attn_mask);
+        struct ggml_tensor * kv_rows = ggml_new_tensor_3d(ctx, GGML_TYPE_I64, T, 1, S);
+        ggml_set_input(kv_rows);
+        // the entry row whose logits are read: [1] index into NT, per branch
+        struct ggml_tensor * pick = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, S);
+        ggml_set_input(pick);
+
+        struct ggml_tensor * emb = ggml_get_rows(ctx, m->embed_tokens, token_ids_t);  // [H, NT]
+        struct ggml_tensor * x   = ggml_mul_mat(ctx, h->fc, ggml_concat(ctx, feat_in, emb, 0));
+        x = qw3lm_build_layer_multi(ctx, gf, c, &h->layer, x, positions, attn_mask, kv_rows, h->kv_k4, h->kv_v4,
+                                    h->max_seq, s0, S, T, n_kv_pad, m->use_flash_attn, m->clamp_fp16);
+        G.feat = x;  // predicted features [H, NT]
+        ggml_set_output(G.feat);
+        struct ggml_tensor * xs = ggml_get_rows(ctx, x, pick);  // [H, S]
+        xs                      = qwen3_rms_norm(ctx, xs, m->final_norm, c.rms_norm_eps);
+        struct ggml_tensor * lm_weight = (lm_count > 0 && m->lm_head_phase2) ? m->lm_head_phase2 : m->embed_tokens;
+        G.out_V                        = (lm_count > 0 && m->lm_head_phase2) ? lm_count : c.vocab_size;
+        G.lgt                          = ggml_mul_mat(ctx, lm_weight, xs);  // [out_V, S]
+        ggml_set_output(G.lgt);
+        ggml_build_forward_expand(gf, G.feat);
+        ggml_build_forward_expand(gf, G.lgt);
+        if (!static_graph_alloc(&G.graph, m->backend, m->sched, gf)) {
+            fprintf(stderr, "[MusicHead] FATAL: graph allocation failed (S=%d, T=%d)\n", S, T);
+            exit(1);
+        }
+        G.gf            = gf;
+        G.token_ids_t   = token_ids_t;
+        G.positions     = positions;
+        G.kv_rows       = kv_rows;
+        G.attn_mask     = attn_mask;
+        G.key_n_kv_pad  = n_kv_pad;
+        G.key_N         = S;
+        G.key_s0        = 0;
+        G.key_lm_offset = lm_offset;
+        G.key_lm_count  = lm_count;
+        h->key_T[gi]    = T;
+        h->key_s0[gi]   = s0;
+        h->feat_in_t[gi] = feat_in;
+        h->pick_t[gi]    = pick;
+        G.pos_data.resize((size_t) NT);
+        G.rows_data.resize((size_t) NT);
+        G.mask_data.resize((size_t) n_kv_pad * NT);
+        G.built = true;
+    }
+
+    ggml_backend_tensor_set(h->feat_in_t[gi], feats, 0, (size_t) H * NT * sizeof(float));
+    ggml_backend_tensor_set(G.token_ids_t, tokens, 0, (size_t) NT * sizeof(int));
+    std::vector<int> pick(S);
+    for (int s = 0; s < S; s++) {
+        int p0  = h->kv_pos[s0 + s];
+        pick[s] = s * T + row;
+        for (int t = 0; t < T; t++) {
+            G.pos_data[(size_t) s * T + t]  = p0 + t;
+            G.rows_data[(size_t) s * T + t] = (int64_t) (p0 + t);
+            uint16_t * mrow                 = G.mask_data.data() + ((size_t) s * T + t) * n_kv_pad;
+            for (int j = 0; j < n_kv_pad; j++) {
+                mrow[j] = ggml_fp32_to_fp16((j <= p0 + t) ? 0.0f : -INFINITY);
+            }
+        }
+    }
+    ggml_backend_tensor_set(G.positions, G.pos_data.data(), 0, (size_t) NT * sizeof(int));
+    ggml_backend_tensor_set(G.kv_rows, G.rows_data.data(), 0, (size_t) NT * sizeof(int64_t));
+    ggml_backend_tensor_set(G.attn_mask, G.mask_data.data(), 0, G.mask_data.size() * sizeof(uint16_t));
+    ggml_backend_tensor_set(h->pick_t[gi], pick.data(), 0, (size_t) S * sizeof(int));
+    static_graph_compute(&G.graph, m->backend, m->sched, G.gf);
+    if (feat_out) {
+        ggml_backend_tensor_get(G.feat, feat_out, 0, (size_t) H * NT * sizeof(float));
+    }
+    ggml_backend_tensor_get(G.lgt, logits, 0, (size_t) G.out_V * S * sizeof(float));
+    for (int s = s0; s < s0 + S; s++) {
+        h->kv_pos[s] += used;
+    }
+}
