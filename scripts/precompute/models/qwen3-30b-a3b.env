# Qwen3-30B-A3B (mixture of experts, 3B active). One A100 80GB.
MODEL=qwen3-30b-a3b
TARGET=Qwen/Qwen3-30B-A3B-GPTQ-Int4          # official 4-bit file (no official AWQ); SGLang serves it with Marlin MoE kernels
PUB_HEAD=AngelSlim/Qwen3-a3B_eagle3          # published EAGLE-3 head we start from (license: see the repo)
OLLAMA_TAG=qwen3:30b-a3b-q4_K_M                 # the original Qwen3-30B-A3B; the plain qwen3:30b-a3b tag now points to the
                                             # Thinking-2507 release (a different model that always reasons out loud)
SF_TEMPLATE=qwen
CHAT_KWARGS='{"enable_thinking": false}'
SYSTEM_TURN=0

