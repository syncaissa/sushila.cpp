# DeepSeek-R1-Distill-Llama-70B (MIT): a reasoning model distilled into Llama-3.3-70B-Instruct. One A100/H100 80GB.
# Checked 2026-10-05: no published EAGLE-3 head for it. Its base, Llama-3.3-70B-Instruct, has one with the same shapes
# (hidden 8192, vocabulary 128,256), so we warm-start from that head and refit it to R1's own answers; report it as
# "the base model's head", not as a head for R1. Ollama deepseek-r1:70b holds "DeepSeek R1 Distill Llama 70B" (checked).
# Reasoning output is long (<think> ... </think>, then the answer): timing uses 256 tokens like every model; GSM8K
# accuracy uses 40 problems with 1,536 tokens, graded on the text after </think>.
MODEL=deepseek-r1-distill-llama-70b
TARGET=casperhansen/deepseek-r1-distill-llama-70b-awq
PUB_HEAD=lmsys/sglang-EAGLE3-LLaMA3.3-Instruct-70B   # the base model's head (warm start)
OLLAMA_TAG=deepseek-r1:70b
SF_TEMPLATE=deepseek-r1-distill                      # SpecForge 53398a8 has this template (checked)
CHAT_KWARGS='{}'
SYSTEM_TURN=0
CTX=2048                                             # the Llama-3.3-70B head declares 2,048 tokens
GSM_SET=gsm40
GSM_MAX=1536
